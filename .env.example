# Copy to .env (make init). Every variable your code reads must be listed here.

# Server — inside Docker the server must bind 0.0.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Client — inside Docker use the service name "server"; natively use "localhost"
CLIENT_TARGET_HOST=server
CLIENT_TARGET_PORT=5000

LOG_LEVEL=INFO

# Browser gateway — open http://localhost:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080

# TCP idle limits
READ_TIMEOUT=90
MAX_CLIENTS=200
MAX_ROOMS=100

# Optional nickname for docker compose run --rm client
PLAYER_NAME=Terminal
